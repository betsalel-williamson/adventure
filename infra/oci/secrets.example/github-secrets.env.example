# Copy this directory to infra/oci/secrets/ (gitignored) and edit.
#   cp -r infra/oci/secrets.example infra/oci/secrets
#
# Never commit infra/oci/secrets/ — it holds paths and OCIR identifiers.
# Put the raw OCIR auth token in ocir-auth-token (see ocir-auth-token.example).

# SSH private key for VM deploy (must match ssh_public_key in terraform.tfvars)
SSH_PRIVATE_KEY_PATH=~/.ssh/oci_key

# OCIR — tenancy namespace (Profile → Tenancy → Object Storage namespace)
OCIR_NAMESPACE=

# OCIR login user: <namespace>/<oci-account-email>
OCIR_USERNAME=

# One-line auth token file (Profile → User → Auth tokens — not the API signing key)
OCIR_AUTH_TOKEN_FILE=infra/oci/secrets/ocir-auth-token
