{
  "name": "adventure-langgraph",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "start": "concurrently -n api,crt,assist -c blue,green,magenta \"npm run dev:server --prefix ../adventure-v2\" \"vite\" \"npm run assist:dev\"",
    "assist:dev": "tsx watch --clear-screen=false --include packages/map-core/src --include packages/assist-server/src packages/assist-server/src/server.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:web": "vitest run --project web",
    "test:watch": "vitest",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/setup.ts tests/features/crt_wire_health.feature tests/features/crt_wire_first_turn.feature tests/features/crt_assist_exploration_wire.feature",
    "test:cucumber:fortran": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/setupFortran.ts tests/features/fortran",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "tsx packages/assist-server/scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code packages/assist-server/openapi.yaml",
    "verify": "npm run lint && npm run format:check && npm test -- --run && npm run test:cucumber && npm run build"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": "prettier --write",
    "eslint.config.js": "prettier --write",
    "prettier.config.js": "prettier --write"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@cucumber/cucumber": "^12.8.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "express": "^5.2.1",
    "mermaid": "^11.14.0"
  }
}
