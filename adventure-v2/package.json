{
  "name": "adventure-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:brain-mermaid": "tsx packages/cognition/scripts/export-brain-mermaid.ts",
    "test": "vitest run",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/setup.ts tests/features/http",
    "test:oracle-fortran": "ADV_V2_CI_FORTRAN=1 vitest run --config vitest.oracle-ci.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev:server": "tsx watch apps/server/src/cli.ts",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "mermaid": "^11.14.0",
    "xstate": "^5.31.0"
  }
}
