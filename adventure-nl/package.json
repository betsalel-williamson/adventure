{
  "name": "adventure-nl",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node dist/cli/main.js",
    "web": "node dist/cli/webDashboard.js",
    "glue-mcp-stdio": "node dist/cli/glueMcpStdio.js",
    "web:tls-init": "node scripts/gen-web-dashboard-dev-certs.mjs",
    "build": "npm run build --workspace=@adventure-nl/nl-glue && tsc && node scripts/bundle-browser-cognition.mjs",
    "build:tsc": "tsc",
    "test": "npm run build --workspace=@adventure-nl/nl-glue && vitest run",
    "test:watch": "vitest",
    "check": "npm run build --workspace=@adventure-nl/nl-glue && npm run deps:phase-a && tsc --noEmit && vitest run",
    "experiment:mlx-system": "npm run build && node scripts/print-mlx-system-prompts.mjs",
    "experiment:mlx-system-smoke": "npm run build && node scripts/smoke-mlx-system-variants.mjs",
    "experiment:interpret-eval": "npm run build && node scripts/eval-interpret-examples.mjs",
    "experiment:mlx-interpret-prompts": "npm run build && node scripts/smoke-mlx-interpret-prompt-variants.mjs",
    "generate:vocab-ai-categories": "npm run build && node scripts/generate-vocab-categories-ai.mjs",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dependency-check": "mkdir -p ./reports/dependency-check && dependency-check --project adventure-nl --scan . --out ./reports/dependency-check --format HTML --format JSON",
    "dependency-check:quick": "mkdir -p ./reports/dependency-check && dependency-check --noupdate --project adventure-nl --scan . --out ./reports/dependency-check --format HTML --format JSON",
    "deps:phase-a": "depcruise --validate .dependency-cruiser.cjs packages/nl-glue/src src/browser",
    "deps:graph": "node scripts/deps-graph.mjs",
    "prepare": "cd .. && husky adventure-nl/.husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^17.3.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@adventure-nl/nl-glue": "*",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@statelyai/inspect": "^0.7.1",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.3.1",
    "ws": "^8.18.0",
    "xstate": "^5.30.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  }
}
