# Copy to .env and fill in (never commit .env).
# NIST NVD API key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
#
# Text model for natural language + autoplay: Google (hosted), OpenAI-compatible HTTP, or Apple Silicon MLX.
# ADVENTURE_NL_TEXT_PROVIDER=google   # explicit Google Generative AI (requires GEMINI_API_KEY)
# ADVENTURE_NL_TEXT_PROVIDER=http     # local/remote OpenAI-compatible API (set ADVENTURE_NL_HTTP_MODEL)
# ADVENTURE_NL_TEXT_PROVIDER=mlx      # native MLX Gemma (Apple Silicon): cd adventure-nl && uv venv && uv sync
# If unset: Google if GEMINI_API_KEY; else HTTP if ADVENTURE_NL_HTTP_MODEL; else MLX if ADVENTURE_NL_MLX_MODEL
#
# Google Generative AI: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-2.5-flash text, gemini-3.1-flash-image-preview for imagery)
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=
#
# OpenAI-compatible chat completions (e.g. Ollama on Mac: ollama pull gemma2 — default base is below)
# ADVENTURE_NL_HTTP_BASE_URL=http://127.0.0.1:11434/v1
# ADVENTURE_NL_HTTP_MODEL=gemma2:9b
# Optional comma-separated extra model names for the autoplay web dashboard dropdown (merged with ADVENTURE_NL_HTTP_MODEL).
# ADVENTURE_NL_HTTP_WEB_PRESETS=llama3.2,gemma2:2b
# ADVENTURE_NL_HTTP_API_KEY=
# OpenAI structured outputs (json_schema + strict enums from adventure.dat). Most Ollama installs do not support this; use official OpenAI or a server that implements it.
# ADVENTURE_NL_HTTP_JSON_SCHEMA=1
# Retry transient HTTP 429/502/503 (attempts 1–5; backoff between attempts).
# ADVENTURE_NL_HTTP_RETRY_ATTEMPTS=3
#
# MLX (Apple Silicon, offline): pyproject.toml + uv (default). See scripts/mlx_lm_worker.py
# Hugging Face token (optional): https://huggingface.co/settings/tokens — higher rate limits for Hub downloads
# HF_TOKEN=
# Default in code: mlx-community/gemma-2-2b-it (set e.g. gemma-2-9b-it-4bit for a larger model if you have RAM)
# ADVENTURE_NL_MLX_MODEL=mlx-community/gemma-2-2b-it
# ADVENTURE_NL_MLX_USE_UV=1          # default on; set 0 to use ADVENTURE_NL_MLX_PYTHON + script without uv
# ADVENTURE_NL_MLX_UV=uv             # uv executable
# ADVENTURE_NL_MLX_PACKAGE_ROOT=   # optional; default is adventure-nl dir (parent of scripts/)
# ADVENTURE_NL_MLX_PYTHON=python3    # used only when ADVENTURE_NL_MLX_USE_UV=0
# ADVENTURE_NL_MLX_SCRIPT=           # optional path to mlx_lm_worker.py
# ADVENTURE_NL_MLX_MAX_TOKENS=512
# ADVENTURE_NL_MLX_READY_TIMEOUT_MS=900000
# Sampling: default 0.75; 0 = greedy. Substrings truncate output (comma-separated).
# ADVENTURE_NL_MLX_TEMP=0.75
# ADVENTURE_NL_MLX_STOP=<start_of_turn>,User:
# Markdown ### state dashboard for MLX (default on for mlx; set 0 to disable)
# ADVENTURE_NL_STRUCTURED_PROMPTS=1
# MLX autoplay system prompt shape (Gemma 2B experiments): full | compact | core | bare (default full)
# ADVENTURE_NL_MLX_SYSTEM_VARIANT=full
# Compare variants with one model load: npm run experiment:mlx-system-smoke
#
# Debug: JSONL log of NL / LLM (set ADVENTURE_NL_DEBUG=1 or path below). Long prompts are truncated (chars per prompt field).
# Web dashboard: one file per browser session under .cache/llm-sessions/<uuid>.jsonl (unless ADVENTURE_NL_DEBUG_LOG forces a single file). Audit/debug only — not a session restore format; server restart discards in-memory sessions.
# ADVENTURE_NL_DEBUG=1
# ADVENTURE_NL_DEBUG_LOG=.cache/llm-interactions.jsonl
# ADVENTURE_NL_DEBUG_MAX_PROMPT_CHARS=50000
# Cache InterpretedCommand JSON (key includes user line, model, provider, prompt layout, recent-game tail).
# Bump ADVENTURE_NL_CACHE_SCHEMA_VERSION to invalidate on-disk caches after behavior changes.
# ADVENTURE_NL_CACHE_DIR=.cache/llm-cache
# ADVENTURE_NL_CACHE_SCHEMA_VERSION=2
#
# Autoplay web dashboard: npm run web (after npm run build). HTTPS on 127.0.0.1 by default (see README).
# First time: npm run web:tls-init (writes .cache/tls/dev-*.pem; requires OpenSSL 1.1.1+ on PATH).
# Or set ADVENTURE_NL_WEB_INSECURE_HTTP=1 for plain HTTP only (session cookie will not be Secure).
# ADVENTURE_NL_WEB_TLS_KEY=.cache/tls/dev-key.pem
# ADVENTURE_NL_WEB_TLS_CERT=.cache/tls/dev-cert.pem
# ADVENTURE_NL_WEB_PORT=8787
# Optional: HTTPS URL of the Stately inspect UI embedded inside the self-hosted bridge (GET /stately-inspect).
# ADVENTURE_NL_STATELY_INSPECT_UI_URL=https://stately.ai/inspect
# Host/IP the server binds to (default 127.0.0.1). Vitest contract tests use the same variable for fetch URLs.
# ADVENTURE_NL_WEB_BIND_HOST=127.0.0.1
# Max distinct {provider, modelId} presets loaded at once; same preset is shared by all sessions using it (one client + ref count). LRU evicts presets with no attached sessions when over cap.
# ADVENTURE_NL_WEB_MAX_LOADED_MODELS=2
#
# Self-acting mode: npm start -- --autoplay (requires a configured text model; cannot combine with --classic)
# ADVENTURE_NL_INSTRUCTIONS=n
# ADVENTURE_NL_AUTOPLAY_PACE_MS=2000
# ADVENTURE_NL_AUTOPLAY_MAX_MOVES=120
#
# Web dashboard: benchmark runs (SQLite WAL). Set to 0 to disable recording.
# ADVENTURE_NL_BENCHMARK_RUNS=1
# Optional DB path (default: adventure-nl/.cache/benchmark-runs.db)
# ADVENTURE_NL_BENCHMARK_DB=
# Optional scope for leaderboard filtering (game night id)
# ADVENTURE_NL_BENCHMARK_EVENT_ID=
# Autoplay planner copy: explore (default) = localized node + exploration-first; full = legacy long prompts
# ADVENTURE_NL_AUTOPLAY_PROMPT_MODE=explore
# Autoplay planner budget (default 6000; 4000–6000 often better for MLX / small models)
# ADVENTURE_NL_AUTOPLAY_CONTEXT_CHARS=6000
# MLX only: first call narrows situation candidates, then planner (2x MLX per move)
# ADVENTURE_NL_AUTOPLAY_TWO_STEP=1
# Compact prompts: unset = on for MLX only (shorter rules, smaller vocab hint, no HELP block in planner). Force with 1/0.
# ADVENTURE_NL_COMPACT_PROMPTS=1
# Override vocab word count in prompts (8–500); default 48 compact / 120 full
# ADVENTURE_NL_VOCAB_HINT_MAX=
# AI-grouped vocabulary JSON for prompts: npm run generate:vocab-ai-categories
# Loads .cache/vocab-categories-ai.json when it exists (cwd), or set explicit path:
# ADVENTURE_NL_VOCAB_CATEGORIES_FILE=/absolute/or/cwd-relative/vocab-categories-ai.json
# ADVENTURE_NL_VOCAB_AI_CATEGORIES=1
# Interpret few-shot EXAMPLES from scripts/interpret-eval-fixtures.json (unset = on for MLX only, off for Google/HTTP; 0 = off, 1 = on)
# ADVENTURE_NL_INTERPRET_PROMPT_EXAMPLES=1
# Omit interpret EXAMPLES for lower latency (overrides provider defaults).
# ADVENTURE_NL_FAST_INTERPRET=1
# Interactive NL: prepend session context + situational candidates (default on; set 0 for legacy thin prompts only)
# ADVENTURE_NL_INTERACTIVE_SESSION=1
# Diagonal compass motion (NE NW SE SW): in adventure.dat but omitted from LLM enums, candidates, and autoplay escape order unless enabled.
# ADVENTURE_NL_DIAGONAL_COMPASS_MOTION=1
# Golden-set interpret eval: npm run experiment:interpret-eval
# MLX Gemma: interpret fixtures × prompt layouts (one model load): npm run experiment:mlx-interpret-prompts
