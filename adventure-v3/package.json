{
  "name": "adventure-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n api,crt -c blue,green \"npm run dev:server --prefix ../adventure-v2\" \"vite\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/setup.ts tests/features/crt_wire_health.feature tests/features/crt_wire_first_turn.feature",
    "test:cucumber:fortran": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/setupFortran.ts tests/features/fortran"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
