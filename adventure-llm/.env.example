# Copy to .env and fill in (never commit .env).
# NIST NVD API key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
#
# Text LLM for natural language + autoplay: Google (hosted), OpenAI-compatible HTTP, or Apple Silicon MLX.
# ADVENTURE_LLM_TEXT_PROVIDER=google   # explicit Google Generative AI (requires GEMINI_API_KEY)
# ADVENTURE_LLM_TEXT_PROVIDER=http     # local/remote OpenAI-compatible API (set ADVENTURE_LLM_HTTP_MODEL)
# ADVENTURE_LLM_TEXT_PROVIDER=mlx      # native MLX Gemma (Apple Silicon): cd adventure-llm && uv venv && uv sync
# If unset: Google if GEMINI_API_KEY; else HTTP if ADVENTURE_LLM_HTTP_MODEL; else MLX if ADVENTURE_LLM_MLX_MODEL
#
# Google Generative AI: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-2.5-flash text, gemini-3.1-flash-image-preview for imagery)
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=
#
# OpenAI-compatible chat completions (e.g. Ollama on Mac: ollama pull gemma2 — default base is below)
# ADVENTURE_LLM_HTTP_BASE_URL=http://127.0.0.1:11434/v1
# ADVENTURE_LLM_HTTP_MODEL=gemma2:9b
# ADVENTURE_LLM_HTTP_API_KEY=
# OpenAI structured outputs (json_schema + strict enums from adventure.dat). Most Ollama installs do not support this; use official OpenAI or a server that implements it.
# ADVENTURE_LLM_HTTP_JSON_SCHEMA=1
#
# MLX (Apple Silicon, offline): pyproject.toml + uv (default). See scripts/mlx_lm_worker.py
# Hugging Face token (optional): https://huggingface.co/settings/tokens — higher rate limits for Hub downloads
# HF_TOKEN=
# Default in code: mlx-community/gemma-2-9b-it-4bit (override if low RAM, e.g. gemma-2-2b-it)
# ADVENTURE_LLM_MLX_MODEL=mlx-community/gemma-2-9b-it-4bit
# ADVENTURE_LLM_MLX_USE_UV=1          # default on; set 0 to use ADVENTURE_LLM_MLX_PYTHON + script without uv
# ADVENTURE_LLM_MLX_UV=uv             # uv executable
# ADVENTURE_LLM_MLX_PACKAGE_ROOT=   # optional; default is adventure-llm dir (parent of scripts/)
# ADVENTURE_LLM_MLX_PYTHON=python3    # used only when ADVENTURE_LLM_MLX_USE_UV=0
# ADVENTURE_LLM_MLX_SCRIPT=           # optional path to mlx_lm_worker.py
# ADVENTURE_LLM_MLX_MAX_TOKENS=512
# ADVENTURE_LLM_MLX_READY_TIMEOUT_MS=900000
#
# Debug: JSONL log of NL / LLM (set ADVENTURE_LLM_DEBUG=1 or path below)
# ADVENTURE_LLM_DEBUG=1
# ADVENTURE_LLM_DEBUG_LOG=.cache/llm-interactions.jsonl
# Cache InterpretedCommand JSON per prompt+model+provider (same key as debug replay)
# ADVENTURE_LLM_CACHE_DIR=.cache/llm-cache
#
# Self-acting mode: npm start -- --autoplay (requires a configured text LLM; cannot combine with --classic)
# ADVENTURE_LLM_INSTRUCTIONS=n
# ADVENTURE_LLM_AUTOPLAY_PACE_MS=2000
# ADVENTURE_LLM_AUTOPLAY_MAX_MOVES=300
# Autoplay planner budget (default 6000; 4000–6000 often better for MLX / small models)
# ADVENTURE_LLM_AUTOPLAY_CONTEXT_CHARS=6000
# MLX only: first call narrows situation candidates, then planner (2x MLX per move)
# ADVENTURE_LLM_AUTOPLAY_TWO_STEP=1
# Compact prompts: unset = on for MLX only (shorter rules, smaller vocab hint, no HELP block in planner). Force with 1/0.
# ADVENTURE_LLM_COMPACT_PROMPTS=1
# Override vocab word count in prompts (8–500); default 48 compact / 120 full
# ADVENTURE_LLM_VOCAB_HINT_MAX=
