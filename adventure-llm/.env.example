# Copy to .env and fill in (never commit .env).
# NIST NVD API key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Google AI (Gemini): https://aistudio.google.com/apikey — enables natural-language first line (use --classic to skip)
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-2.5-flash text, gemini-3.1-flash-image-preview for imagery)
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=
# Debug: JSONL log of NL / Gemini (set ADVENTURE_LLM_DEBUG=1 or path below)
# ADVENTURE_LLM_DEBUG=1
# ADVENTURE_LLM_DEBUG_LOG=.cache/llm-interactions.jsonl
# Cache InterpretedCommand JSON per prompt+model (same key as debug replay)
# ADVENTURE_LLM_CACHE_DIR=.cache/llm-cache
#
# Self-acting mode: npm start -- --autoplay (requires GEMINI_API_KEY; cannot combine with --classic)
# ADVENTURE_LLM_INSTRUCTIONS=n
# ADVENTURE_LLM_AUTOPLAY_PACE_MS=2000
# ADVENTURE_LLM_AUTOPLAY_MAX_MOVES=300
# ADVENTURE_LLM_AUTOPLAY_CONTEXT_CHARS=12000
