{
  "protocol": {
    "profile": "alpha",
    "ref": "v0.4.1"
  },
  "extensions": {
    "packs": [{ "id": "prompts-mdcp-defaults", "enabled": true, "version": "0.4.0.0" }]
  },
  "outputDir": "_build",
  "compileOrder": ["glossary", "features", "developer", "client"],
  "guides": [
    {
      "name": "glossary",
      "compile": {
        "outputFile": "glossary.md",
        "sectionsHeading": "Terms"
      }
    },
    {
      "name": "features",
      "compile": {
        "outputFile": "features-v3.md",
        "sectionsHeading": "Sections",
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "outputFile": "developer.md",
        "sectionsHeading": "Sections",
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "client",
      "compile": {
        "outputFile": "client-v3.md",
        "sectionsHeading": "Sections",
        "scopeRoot": "glossary"
      }
    }
  ],
  "refs": { "registryFile": ".caches/refs.json", "slugAlgorithm": "github" },
  "lint": {
    "markdownlint": {
      "shardsConfig": "node_modules/@bwilliamson/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "node_modules/@bwilliamson/mdcp-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    },
    "xrefs": { "enabled": true },
    "links": { "enabled": true }
  },
  "export": {
    "llm": {
      "stripHtmlComments": true,
      "stripFrontmatter": true,
      "stripBanner": true,
      "collapseBlankLines": true
    }
  }
}
